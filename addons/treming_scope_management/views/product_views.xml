<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define the Window Action for Digital Files -->
    <record id="action_product_digital_files" model="ir.actions.act_window">
        <field name="name">Digital Files</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ir.attachment</field>
        <field name="binding_model_id" ref="model_product_template"/> <!-- Bind to product.template -->
        <field name="binding_type">action</field> <!-- Places it under "More" submenu -->
        <field name="view_mode">tree,form</field>
        <field name="domain">[('res_model', '=', 'product.template'), ('res_id', '=', active_id), ('mimetype', 'ilike', 'pdf')]</field>
        <field name="context">{'default_res_model': 'product.template', 'default_res_id': active_id}</field>
        <field name="target">current</field>
    </record>

    <!-- Inherit Product Template Form View -->
    <record id="view_product_template_form_inherit_digital" model="ir.ui.view">
        <field name="name">product.template.form.inherit.digital.files</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add smart button to button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_digital_files" type="object" class="oe_stat_button" icon="fa-file-pdf-o">
                    <field name="attachment_count" string="Digital Files" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>